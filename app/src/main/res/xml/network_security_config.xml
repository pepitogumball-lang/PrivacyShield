<?xml version="1.0" encoding="utf-8"?>
<!--
    PrivacyShield is fully offline. No cleartext traffic is allowed.
    This config explicitly blocks all cleartext (HTTP) connections.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
